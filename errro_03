void check(char x[])
 {
     for(int i=0; i!='\0'; i++){
        if(isalpha(x[i])){
            enqueue(x[i]);
            push(x[i]);
        }
     }
 }

 void palindrome() {
  if(tolower(pop()) == tolower(dequeue()))
  {
      if(front==NULL && top==NULL )
      {
