typedef struct node {
    char data;
    struct node* next;
}newNode;
char string[30];
newNode* top = NULL;
newNode*  front = NULL;
newNode*  rear = NULL;

void enqueue (char x)
 {
      newNode* node = (newNode*) malloc(sizeof(newNode));
     if(node==NULL){
        printf("Overflow\n");
        return;
     }
     if(front == NULL && rear == NULL)
     {
         front = node;
         //node -> data = x;
         //strcpy(node->data,x);
         node->data = x;

         rear = node;
         node ->next = NULL;

     }
     //strcpy(node->data,x);
     node->data = x;
     rear ->next = node;
     rear = node;
     node ->next = NULL;


 }

 char dequeue()
 {
     /*if(front==NULL){
