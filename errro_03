        return '\0';
     }*/
    newNode* temp = front;
    return front->data;
    front = front->next;
    free(temp);

 }
void push(char data) {
    struct node* newNode = (struct node*) malloc(sizeof(struct node));
    if(newNode==NULL){
    printf("New node hasn't created!\n");
    }
    else {
        newNode -> data = data;
        newNode-> next = top;
        top = newNode;
    }

}
